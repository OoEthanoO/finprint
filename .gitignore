# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# data & artifacts (regenerate with the pipeline)
data/
# ignore scratch checkpoints, but track the one the app serves so a fresh
# clone can deploy species without retraining
models/*.pt
!models/species_cnn.pt
reports/*.png

# hf cache
.cache/

# self-hosting runtime state (scripts/selfhost). Machine-specific and, in the
# case of the Vercel token and the Caddy certificate store, secret.
.caches/
logs/
scripts/selfhost/Caddyfile
scripts/selfhost/run-app.cmd
scripts/selfhost/run-caddy.cmd

# os
.DS_Store
