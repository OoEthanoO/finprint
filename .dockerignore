# keep the build context small & the image clean
.git
.gitignore
.venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.cache
.DS_Store

# regenerable / large artifacts — not needed to serve
data/
reports/*.png

# tests aren't run in the serving image (pytest isn't a runtime dependency)
tests/

# local tooling
.claude/
scratchpad/
